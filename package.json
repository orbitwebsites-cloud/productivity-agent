{
  "name": "screenbuddy",
  "version": "0.1.1",
  "description": "Pesto - a desktop focus companion that tracks pursuits, restores context, and guards against drift.",
  "main": "electron/main.js",
  "author": "Orbit Boyzz",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.orbitboyzz.screenbuddy",
    "productName": "ScreenBuddy",
    "npmRebuild": false,
    "icon": "assets/pesto/screenbuddy_mascot_idle.png",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/.cache/puppeteer/**/*"
    ],
    "asarUnpack": [
      "node_modules/.cache/puppeteer/**/*",
      "node_modules/puppeteer/**/*",
      "node_modules/puppeteer-core/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "identity": null,
      "artifactName": "ScreenBuddy-${version}-${arch}.${ext}"
    },
    "win": {
      "signExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "ScreenBuddy-Setup-${version}.exe"
    },
    "publish": {
      "provider": "generic",
      "url": "https://bglwicwloz5njbgs.public.blob.vercel-storage.com/releases/",
      "channel": "latest"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.26.0",
    "ws": "^8.18.0"
  },
  "allowScripts": {
    "koffi@3.1.0": true
  }
}
