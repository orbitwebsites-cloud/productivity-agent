# Copy this file to .env (same folder) and paste your real keys.
# .env stays on this machine — it is excluded from Vercel uploads and the installer.

# Stripe → Developers → API keys → Secret key (sk_test_... to test, sk_live_... for real)
STRIPE_SECRET_KEY=paste-here

# Supabase dashboard → project "screenbuddy" → Project Settings → API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=paste-here

# Free-tier LLM key. Default provider is Cerebras (cloud.cerebras.ai — free, no card,
# 1M tokens/day, the best free daily cap around). To use a different OpenAI-compatible
# provider instead (Groq, Gemini, OpenRouter, ...), also set LLM_BASE_URL / LLM_MODEL below.
LLM_API_KEY=paste-here

# Optional — monthly price in USD (default 4.99)
# PREMIUM_PRICE_USD=4.99

# Optional — only needed if NOT using Cerebras's default
# LLM_BASE_URL=https://api.cerebras.ai/v1
# LLM_MODEL=llama-3.3-70b
